# Prices are in pounds. Copy to profiles.toml and edit.

[settings]
marketplace            = "EBAY_GB"
currency               = "GBP"
db_path                = "tracker.db"
sweep_minutes          = 30
endgame_seconds        = 60
endgame_horizon_minutes = 15
heartbeat_hours        = 6
results_per_profile    = 20
# dry_run logs alerts instead of sending them - leave true until you trust it
dry_run                = true

# Local dashboard. Binds to localhost by default. Binding anything else
# requires a token, since the dashboard records purchases and edits tracking.
[web]
enabled = true
host    = "127.0.0.1"
port    = 8000
# token = "set-a-long-random-string"   # or set WEB_TOKEN in .env

[[profile]]
id                = "a7iii"
name              = "Sony A7 III body"
query             = "sony a7 iii body"
ceiling           = 1200          # never alert above this landed cost
target            = 950           # your estimate, used until real data lands
min_feedback_pct  = 97.0
min_feedback_count = 25

  [profile.filters]
  conditions     = ["USED", "SELLER_REFURBISHED"]
  buying_options = ["FIXED_PRICE", "AUCTION"]

[[profile]]
id      = "rtx4090"
name    = "RTX 4090"
query   = "rtx 4090"
ceiling = 1600
target  = 1300

  [profile.filters]
  buying_options = ["FIXED_PRICE"]

[[profile]]
id      = "sub16610"
name    = "Rolex Submariner 16610"
query   = "rolex submariner 16610"
ceiling = 9000
target  = 7500
min_feedback_count = 100
enabled = false

# Optional model-based judging stage. Runs behind the rules, never instead of
# them: only listings the rules already rated worth sending are judged.
# Requires ANTHROPIC_API_KEY in .env and `pip install anthropic`.
[ai]
enabled       = false
effort        = "medium"    # low | medium | high | xhigh | max
batch_size    = 8           # listings per request; the main cost lever
max_tokens    = 8000
daily_budget  = 2.00        # pounds per day, hard stop when reached
